# Base URL for the GraphQL API exposed by e-commerce-backend
NEXT_PUBLIC_GRAPHQL_ENDPOINT="http://localhost:4000/graphql"

# Optional branding string used in the UI (header titles, metadata)
NEXT_PUBLIC_SITE_NAME="ShopX"

# Base path for the server-side services (GraphQL proxy + cache tooling)
NEXT_PUBLIC_SERVER_SERVICES_BASE_PATH="/api/serverSideServices"

# Toggle to enable browser calls via the server-side services proxy.
# Keep false for local development to hit the GraphQL backend directly.
NEXT_PUBLIC_USE_SERVER_SERVICES="false"

# Shared secret required when calling cache tooling routes (?api=<token>)
# Keep this in sync with your deployment environment variables
SERVER_SERVICES_TOKEN="development"

# Redis connection for the frontend cache layer
REDIS_URL="redis://127.0.0.1:6379"

# Namespace prefix for keys written by the frontend (keeps caches isolated)
REDIS_CACHE_PREFIX="shopx:frontend"

# Default TTL (seconds) for cached GraphQL queries unless overridden per call
REDIS_CACHE_TTL="300"
